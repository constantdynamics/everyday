<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: nothing at all may go into a backup. -->
<full-backup-content xmlns:tools="http://schemas.android.com/tools" tools:ignore="FullBackupContent">
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
